:3604,"category":12365,"parent":3604,"language":12506},"ZW-MI","Midlands",[29900,29901,29902,29904,29905,29907,29908],{"actual":31,"id":31,"display":31},{"actual":31,"id":331,"display":331},{"actual":31,"id":342,"display":29903},"data pack",{"actual":46,"id":46,"display":46},{"actual":12,"id":12,"display":29906},"resource pack",{"actual":34,"id":34,"display":34},{"actual":29909,"id":29909,"display":29909},"server",{"pluginLoaders":29911,"pluginPlatformLoaders":29912,"allPluginLoaders":29913,"dataPackLoaders":29914,"modLoaders":29915,"hiddenModLoaders":29916},[329,417,401,405,421,350],[334,432,428],[329,417,401,405,421,334,432,428,350],[342],[354,346,409,374,381,413,385],[374,381,413],[29918,29919,29920],"list","grid","gallery",[29922,29923,29924,29925],"approved","archived","unlisted","private",[29927,29928],"rejected","withheld",[29930,29931],"moderator","admin",[29933,29964,29993,30022,30047,30086,30142,30185,30368,30408,30446,30482,30524,30593,30654,30685,30715,30751,30782,30820,30846,30881,30912,30948,31012,31042,31100,31179,31231,31260,31334,31363,31407,31454,31495,31526,31553,31613,31880,31934,31978,32008,32043,32079,32118,32149,32194,32225,32288,32324,32358,32396,32427,32469,32498,32563,32613,32661,32698,32745],{"client_side":29934,"server_side":29935,"game_versions":29936,"id":29937,"slug":29938,"project_type":31,"team":29939,"organization":3604,"title":29938,"description":29940,"body":29941,"body_url":3604,"published":29942,"updated":29943,"approved":29944,"queued":29945,"status":29922,"requested_status":29922,"moderator_message":3604,"license":29946,"downloads":29949,"followers":29950,"categories":29951,"additional_categories":29952,"loaders":29953,"versions":29954,"icon_url":29956,"issues_url":3604,"source_url":3604,"wiki_url":3604,"discord_url":3604,"donation_urls":29957,"gallery":29960,"color":29961,"thread_id":29962,"monetization_status":29963},"unsupported","required",[1481,1406,1388,1325,1310,1283,1226,1193,1184,1148,1109,1061,1055,1022,980,974,902,896,859],"OqnoIi0C","theboard","XWkThd8y","Simply scoreboard plugin with PlaceholderAPI supports","**Welcome!**\n\nThis plugin is designed to create a customizable scoreboard\n\nWith the `/sb` command you can disable and enable your own scoreboard.\nAnd with `/theboard reload` you can reload the plugin.\n\n## Is PlaceholderAPI supported?\nYes, PlaceholderAPI is fully supported\n\n## What permissions does the plugin have?\n`theboard.toggle` - This is the permission for the `/sb` command (it works for all players by default).\n\n`theboard.admin` - This is the permission for the `/theboard reload` command (it works for all operators by default).\n\nThere will be more descriptions in the future, as well as new features!\n\n\u003Cdetails>\n\u003Csummary>RU\u003C/summary>\n\nДобро пожаловать!\n\nЭтот плагин предназначен для создания настраевомого скорборда\n\nС помощью команды `/sb` вы можете отключить и включить скорборд у себя.\nА с помощью команды `/theboard reload` вы можете перезагрузить плагин.\n\n## Поддерживается ли PlaceholderAPI?\nДа, PlaceholderAPI полностью поддерживается\n\n## Какие разрешения есть в плагине?\n`theboard.toggle` - Это разрешение для команды `/sb` (оно работает у всех игроков по умолчанию)\n\n`theboard.admin` - Это разрешение для команды `/theboard reload` (оно работает у всех операторов по умолчанию\n\nВ будущем описание будет больше, как и новых функций!\n\n\u003C/details>\n\n","2024-06-30T08:25:01.435437Z","2024-06-30T11:55:39.352100Z","2024-07-03T14:15:35.170702Z","2024-06-30T13:13:56.481708Z",{"id":29947,"name":29948,"url":3604},"MIT","MIT License",527,0,[175],[],[401,405,417],[29955],"1fnnMNYo","https://cdn.modrinth.com/data/OqnoIi0C/1f5a7b4dc31b9212ebf9852f822fdde4be52accb_96.webp",[29958],{"id":3164,"platform":3165,"url":29959},"https://www.donationalerts.com/r/loginor4ik",[],2909340,"cRdpPd4c","monetized",{"client_side":29934,"server_side":29935,"game_versions":29965,"id":29966,"slug":29967,"project_type":31,"team":29968,"organization":3604,"title":29969,"description":29970,"body":29971,"body_url":3604,"published":29972,"updated":29973,"approved":29974,"queued":29975,"status":29923,"requested_status":29922,"moderator_message":3604,"license":29976,"downloads":29978,"followers":29979,"categories":29980,"additional_categories":29981,"loaders":29982,"versions":29983,"icon_url":29987,"issues_url":3604,"source_url":3604,"wiki_url":3604,"discord_url":29988,"donation_urls":29989,"gallery":29990,"color":29991,"thread_id":29992,"monetization_status":29963},[859,853,805,802,772,724,682,673,667,622,616,571],"OsPydya9","antisignedit","zXkscsa3","AntiSignEdit","Minecraft plugin that locks signs after a player finishes writing on them, preventing any future edits","# AntiSignEdit\n\nA simple Folia-compatible Minecraft 1.21.x plugin that locks signs after a player finishes writing on them, preventing any future edits.\n\n---\n\n## Features\n\n- Locks signs the moment the sign GUI closes after placement\n- Automatically locks pre-existing signs (placed before the plugin was installed) on first interaction\n- Works with all sign types: classic signs, wall signs, and all hanging sign variants\n- Signs can still be broken normally\n- Ops and players with `antisignedit.bypass` can still edit signs freely\n- Configurable message shown when a player is blocked (or disable the message entirely)\n- Folia compatible via `RegionScheduler`\n\n---\n\n## Permissions\n\n| Permission            | Default | Description                              |\n|-----------------------|---------|------------------------------------------|\n| `antisignedit.bypass` | op      | Allows the player to bypass sign locking |\n\n---\n\n## Configuration\n\nLocated at `plugins/AntiSignEdit/config.yml` after first run.\n\n```yaml\nmessages:\n  # Set to false to silently block without sending any message\n  send-on-block: true\n\n  # Supports full MiniMessage formatting\n  edit-blocked: \"\u003Cred>This sign has been locked and cannot be edited.\"\n```\n\n## How It Works\n\n**New signs:** When a player closes the sign editing GUI, `SignChangeEvent` fires. A region-scheduled task (Folia-safe) immediately waxes the sign block after the event resolves. Waxed signs cannot be opened for editing in vanilla Minecraft.\n\n**Pre-existing signs:** When a player right-clicks any unwaxed sign, the plugin waxes it on the spot before cancelling the interaction. This means old signs are retroactively locked on first touch.\n\n**Bypass:** If the interacting player is an op (`player.isOp()`) or has the `antisignedit.bypass` permission, the interaction is not cancelled and they may edit freely.\n","2026-02-18T01:56:23.867589Z","2026-02-19T19:34:48.068124Z","2026-02-18T03:23:26.986377Z","2026-02-18T02:17:55.700018Z",{"id":29947,"name":29948,"url":29977},"https://github.com/MistaSoup/AntiSignEdit/blob/main/LICENSE.txt",54,2,[134,275],[93,175],[350,401,405,417],[29984,29985,29986],"JE9ijNFy","mLhQGPrk","iPhZctNd","https://cdn.modrinth.com/data/OsPydya9/e0e9d1aab505cfae97e5f10a60df8450c5d8b5e5_96.webp","https://discord.gg/k7WjYxPxB8",[],[],15527148,"LN6Jqgc0",{"client_side":29934,"server_side":29935,"game_versions":29994,"id":29995,"slug":29996,"project_type":31,"team":29997,"organization":3604,"title":29998,"description":29999,"body":30000,"body_url":3604,"published":30001,"updated":30002,"approved":30003,"queued":30004,"status":29922,"requested_status":29922,"moderator_message":3604,"license":30005,"downloads":30006,"followers":29979,"categories":30007,"additional_categories":30008,"loaders":30009,"versions":30010,"icon_url":30014,"issues_url":30015,"source_url":30016,"wiki_url":3604,"discord_url":30017,"donation_urls":30018,"gallery":30019,"color":30020,"thread_id":30021,"monetization_status":29963},[859,853,805,802,772],"OrjjwusR","unified-crops","tMwxXrwC","Unified Crops","No more duplicate crops and seeds!","# Unified Crops\n\nNo more duplicate crops and seeds!\n\n\u003Ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/o9gwDGuwwLs?si=c6cRCaINiKym0C18\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen>\u003C/iframe>\n\n## Overview\n\nThis mod reduces the clutter from multiple mods adding the same crop to the game\nby setting one as a \"default item\".\n\nFor example, both Pam's Harvestcraft (PHC), Farmer's Delight (FD), and Mama's Herbs and Harvest (MHH)\nadd a version of rice. By default, each version will show up in your world, so \nyou'll have 3 different versions of rice to choose to farm. Even worse is the \nMama's version of rice doesn't have the correct tag, so can't be used for making food.\n\nWith this mod, the default rice is Pam's Harvestcraft. If you find loot, it will PHC\nrice. If you cut down some crops, the seeds will be PHC rice seeds. Etc.\nFurthermore, all the recipes are modified appropriately. If for some reason, \nyou need a different version, the mod adds \"morph\" recipes for easy one-to-one\nconversion. \n\n## Specifics\n\nThis mod is data-driven, so you can change the default items and add more crops\nas you wish. The file is located at `config/crop_data.json`. A default version\nhas been created with the following mods:\n\n- Pam's Harvestcraft\n- Farmer's Delight\n- Sushi Go\n- Mama's Herbs and Harvest\n\nThe default file can be found [in the Github](https://github.com/pitbox46/UnifiedCrops/blob/master/src/main/resources/crop_data.json)\nif you ever need it. If no file exists in `config/crop_data.json`,\nthe default file is copied over to that location.\n\n## Links\n\n- [Github Source Code](https://github.com/pitbox46/UnifiedCrops)\n- [Modrinth](https://modrinth.com/mod/unified-crops)\n- [Curseforge](https://legacy.curseforge.com/minecraft/mc-mods/unified-crops)","2025-03-18T02:56:56.170366Z","2025-03-22T20:28:22.454196Z","2025-03-21T00:59:37.489484Z","2025-03-18T03:02:42.860318Z",{"id":29947,"name":29948,"url":3604},1367,[131,303],[175,279],[385],[30011,30012,30013],"7f4jqrXb","p67kDZDg","D1uNbKhB","https://cdn.modrinth.com/data/OrjjwusR/d1c519e8f64f6251bb2f8b76a7f9b523abbeecf0_96.webp","https://github.com/pitbox46/UnifiedCrops/issues","https://github.com/pitbox46/UnifiedCrops","https://discord.gg/cZbRsXGXZt",[],[],3948058,"ZtBsrCIn",{"client_side":29935,"server_side":29935,"game_versions":30023,"id":30024,"slug":30025,"project_type":31,"team":30026,"organization":3604,"title":30027,"description":30028,"body":30029,"body_url":3604,"published":30030,"updated":30031,"approved":30032,"queued":3604,"status":29922,"requested_status":29922,"moderator_message":3604,"license":30033,"downloads":30034,"followers":29950,"categories":30035,"additional_categories":30036,"loaders":30037,"versions":30038,"icon_url":30042,"issues_url":3604,"source_url":30043,"wiki_url":3604,"discord_url":3604,"donation_urls":30044,"gallery":30045,"color":30046,"thread_id":30024,"monetization_status":29963},[2099,1481],"Os0tfaTT","gdtweaker","WKuNgLbp","GDTweaker","Use Crt to modify Gaia Dimension's recipes.","### Use CraftTweaker to modify Gaia Dimension's recipes.\n  \n### Example:\n1.12.2  \n  \n```\nimport mods.GDTweaker.GDTweaker;\n\nGDTweaker.addPurifyRecipe(\u003Cminecraft:diamond>,\u003Cminecraft:stone>,\u003Cminecraft:dirt>,1);\nGDTweaker.addGlitterRecipe(\u003Cminecraft:diamond_block>,\u003Cminecraft:nether_star>,\u003Cminecraft:iron_ingot>,1);\nGDTweaker.removePurifyRecipe(\u003Cgaiadimension:corrupt_grass>);\nGDTweaker.removeGlitterRecipe(\u003Cgaiadimension:green_opal>);\n```\n  \n1.16.5  \n  \n```\n\u003Crecipetype:gaiadimension:purifying>.addRecipe(\"test\",\u003Citem:minecraft:diamond>,\u003Citem:minecraft:coal>,\u003Citem:minecraft:charcoal>,1f,10);\n\u003Crecipetype:gaiadimension:purifying>.removeRecipeByName(\"gaiadimension:purifying/pink_agate_wood\");\n\u003Crecipetype:gaiadimension:restructuring>.addRecipe(\"test1\",\u003Citem:minecraft:enchanted_golden_apple>,\u003Citem:minecraft:gold_ingot>,\u003Citem:minecraft:golden_apple>,1f,10);\n\u003Crecipetype:gaiadimension:restructuring>.removeRecipeByName(\"gaiadimension:restructuring/proustite\");\n```\n   \n### Require CraftTweaker and Gaia Dimension.","2023-01-01T07:32:58.676478Z","2023-04-18T09:27:35.044837Z","2023-01-01T10:36:29.402692Z",{"id":29947,"name":29948,"url":3604},1018,[303],[],[354],[30039,30040,30041],"CbMYRFn8","n7ahLmP4","TfWmbTO7","https://cdn.modrinth.com/data/Os0tfaTT/b56a8d2028905ef23b2ff430b7689eb1a886ffc0_96.webp","https://github.com/BiggestXuan/GDTweaker",[],[],263172,{"client_side":29935,"server_side":29934,"game_versions":30048,"id":30049,"slug":30050,"project_type":34,"team":30051,"organization":30052,"title":30053,"description":30054,"body":30055,"body_url":3604,"published":30056,"updated":30057,"approved":30058,"queued":30059,"status":29922,"requested_status":29922,"moderator_message":3604,"license":30060,"downloads":30062,"followers":30063,"categories":30064,"additional_categories":30065,"loaders":30066,"versions":30067,"icon_url":30073,"issues_url":30074,"source_url":3604,"wiki_url":3604,"discord_url":30075,"donation_urls":30076,"gallery":30077,"color":30084,"thread_id":30085,"monetization_status":29963},[896,859],"OqfMRXtF","ultraoptimized","Mb0U29w8","yvR1UXUc","Ultra Optimized","Ultra Optimized is a high-FPS modpack that makes Minecraft way smoother and faster! Less lag, more frames, better gameplay—everywhere you play!","# Ultra Optimized\n\n**Ultra Optimized** is a performance-focused modpack designed to give your Minecraft a serious FPS boost. Whether you're in singleplayer or joining a multiplayer server, this modpack helps make your game run smoother, cleaner, and faster.\n\n## Key Features\n\n- 🚀 **Boosted FPS** – Carefully selected optimization mods to reduce lag and increase frame rates\n- 🎮 **Compatible Everywhere** – Works with any server or singleplayer world\n- 🧩 **Lightweight Resource Packs** – Designed to ease performance load\n- 🔧 **No Extra Bloat** – Just performance improvements, nothing unnecessary\n\n## Compatibility\n\nThis modpack can be used on any world or server. To keep the performance gains, avoid adding heavy mods. We recommend to use the pack as provided, as we can only guarantee functionality in an unmodified environment.\n\n## Partnerships\n\n**🤝 SafiNetwork** – A good free2play Minecraft Network! [Join here](https://discord.gg/BEYRpMnpBf)\n\n## Need Help?\n\nOfficial Discord links are in the \"Links\" box, somewhere around this description.","2024-08-12T08:06:14.961499Z","2024-08-22T08:13:34.052812Z","2024-08-16T05:12:23.499938Z","2024-08-14T16:39:40.092089Z",{"id":30061,"name":10,"url":3604},"LicenseRef-All-Rights-Reserved",346,1,[162,211,288],[77],[346],[30068,30069,30070,30071,30072],"sxDdG6q1","pqmjoiLS","fNWhaF7j","O9nR3Cc0","B5XuUrQX","https://cdn.modrinth.com/data/OqfMRXtF/b326edfb6464b07280425ae548cd6f392424752f_96.webp","https://discord.gg/ejHc8Nv5wd","https://discord.gg/uJ9bMHARcQ",[],[30078],{"url":30079,"raw_url":30080,"featured":439,"title":30081,"description":30082,"created":30083,"ordering":29950},"https://cdn.modrinth.com/data/OqfMRXtF/images/bb54b2fc4f96b32b34862c6b4c30d3e6cba85511_350.webp","https://cdn.modrinth.com/data/OqfMRXtF/images/bb54b2fc4f96b32b34862c6b4c30d3e6cba85511.png","Look At My FPS!","Running around gives you about 800 FPS while looking at the sky gives you 1000+ FPS!","2024-08-12T08:28:38.214370Z",8921583,"45m5h1oV",{"client_side":29935,"server_side":29935,"game_versions":30087,"id":30088,"slug":30089,"project_type":31,"team":30090,"organization":3604,"title":30091,"description":30092,"body":30093,"body_url":3604,"published":30094,"updated":30095,"approved":30094,"queued":3604,"status":29922,"requested_status":3604,"moderator_message":3604,"license":30096,"downloads":30097,"followers":30098,"categories":30099,"additional_categories":30100,"loaders":30101,"versions":30102,"icon_url":30128,"issues_url":30129,"source_url":30130,"wiki_url":3604,"discord_url":30131,"donation_urls":30132,"gallery":30135,"color":30141,"thread_id":30088,"monetization_status":29963},[1388,1325,1310,1283,1226,1193,1184,1148,1109,1061,1055,1022,974,896,859,853,772,724,673,667,616,571,517,511,499,450],"OrtjXTCH","chalk","OwUiDfcX","Chalk (Fabric)","Fabric port of the forge mod chalk by mortuusars with some additions ","![All Chalk Variants](https://cdn.modrinth.com/data/OrtjXTCH/images/19073a0222fbd770cd038677927ea160e4eb8f32.png)\n\n# Chalk\nFabric port of the Minecraft mod [Chalk](https://github.com/mortuusars/Chalk) by mortuusars with some additions and adjustments. Thank you very much for creating the original Forge version and the permission to port Chalk to fabric!\n\n## Adds Chalk to aid you on your mining journeys. Never lose your way again.\n- Chalk: Crafted shapeless with 2 Calcite (+Dye)\n- Glow Chalk: Crafted shapeless with 2 Calcite and a Glow Ink Sac (+Dye)\n- Chalk comes in all 16 vanilla colors. To get colored chalk add a piece of dye to your chalk recipe\n\nWith chalk, you are able to mark the surface of every full block. \nHitting the corner of a block creates an arrow pointing in that direction, hitting the center creates an X.\nMarks from Glow Chalk can be seen in total darkness, perfect for caving action!\n\n# Want Chalk in all colors of the rainbow as seen in the screenshot?\n=> Check out the addon: [Chalk (Fabric): Colorful Addon](https://modrinth.com/mod/chalk-colorful-addon)\n\n(the 1.18.2 versions contain colored chalk by default)","2021-10-10T11:27:59.736989Z","2026-06-24T13:41:06.491784Z",{"id":29947,"name":29948,"url":3604},1228388,367,[30,100],[],[346,409],[30103,30104,30105,30106,30107,30108,30109,30110,30111,30112,30113,30114,30115,30116,30117,30118,30119,30120,30121,30122,30123,30124,30125,30126,30127],"uPEa7LBz","WIVrCBs3","fKY5zkWz","HExgjOqr","CS1O3hSY","z9yPuJ33","2kBPnANn","n13hCKyu","cgEqOhr8","nsVYyiwH","HfoNoOrC","jWMVQdZu","IIKlspc0","AnIA4EcY","WkGeDM7U","zubQVJDq","Lsc3Pk9I","Pxtm7pgf","zIEsBS0e","DHZ3XRxJ","zYEb6qj1","c3JOqf9m","G9Oljtjl","t82eeyB1","Im9gI64u","https://cdn.modrinth.com/data/OrtjXTCH/70c0d9eeb8aabac3fb6a9f5c4235356a13438b2a_96.webp","https://github.com/DaFuqs/Chalk/issues","https://github.com/DaFuqs/Chalk","https://discord.gg/EXU9XFXT8a",[30133],{"id":3161,"platform":3162,"url":30134},"https://ko-fi.com/dafuqs",[30136],{"url":30137,"raw_url":30138,"featured":861,"title":30139,"description":3604,"created":30140,"ordering":29950},"https://cdn.modrinth.com/data/OrtjXTCH/images/7dcfde03f97ec81126d51b7e0fd574fee2acee5f_350.webp","https://cdn.modrinth.com/data/OrtjXTCH/images/19073a0222fbd770cd038677927ea160e4eb8f32.png","All chalk variants","2022-04-06T11:46:19.621611Z",6438693,{"client_side":30143,"server_side":29935,"game_versions":30144,"id":30145,"slug":30146,"project_type":31,"team":30147,"organization":3604,"title":30148,"description":30149,"body":30150,"body_url":3604,"published":30151,"updated":30152,"approved":30153,"queued":30154,"status":29922,"requested_status":29922,"moderator_message":3604,"license":30155,"downloads":30157,"followers":30158,"categories":30159,"additional_categories":30160,"loaders":30161,"versions":30162,"icon_url":30177,"issues_url":30178,"source_url":30179,"wiki_url":3604,"discord_url":30180,"donation_urls":30181,"gallery":30182,"color":30183,"thread_id":30184,"monetization_status":29963},"optional",[859,853],"OqaxVwcZ","privileged","1VRU7v9q","Privileged","Lock game content behind stages.","# Privileged\n\nProvides stages which lock certain aspects of the game, such as blocks or items, behind stages.\nPack makers can use json files to specify when an object should become accessible and how it should be hidden.\n\n## Documentation\n\nReplacement data is placed into the `data/${namespace}/privilege` folder and has the following structure:\n\nCurrently, the following types are available:\n| Identifier | System |\n|----|----|\n| `privileged:block` | Blocks |\n| `privileged:item` | Items |\n| `privileged:block_state` | Block States |\n\nMore in-depth documentation can be found in [the docs folder on GitHub](https://github.com/cschierig/Privileged).\nThere you can find information on what the individual systems achieve and what their limitations are.\n\nTo gain a stage you can use the `/stage` command. The syntax is very similar to that of the `/advancement` command.\n\n## Usage & Dependencies\n\nThis mod requires [Fabric API](https://modrinth.com/mod/fabric-api) on Fabric.\n\nYou can optionally use [Jade](https://modrinth.com/mod/jade). Basic Stages will correctly\nhide blocks and items when looked at with Jade.\n\n\n","2024-06-16T11:02:26.451519Z","2024-07-13T09:50:49.702879Z","2024-06-21T05:38:01.065715Z","2024-06-19T16:41:22.538905Z",{"id":29947,"name":29948,"url":30156},"https://github.com/cschierig/Basic-Stages/blob/dev/1.20.6/LICENSE",1436,10,[30,134],[],[346,385,409],[30163,30164,30165,30166,30167,30168,30169,30170,30171,30172,30173,30174,30175,30176],"11p8GOt0","KKWAEVKl","sVhcQsA7","jYElrWOF","vKpCjXAh","HngLotz4","nsYTR6an","6gSnatg6","qLZ3Lr9K","MKUqzlKJ","XGjhRtX9","MnKV2up0","2hdguviY","rzA596jz","https://cdn.modrinth.com/data/OqaxVwcZ/f1fd405de82ee73a60846ef3d72230adab34d3f4.png","https://github.com/cschierig/Privileged/issues","https://github.com/cschierig/Privileged","https://discord.gg/z96bSp3K",[],[],11306036,"alQARomx",{"client_side":29935,"server_side":29935,"game_versions":30186,"id":30187,"slug":30188,"project_type":31,"team":30189,"organization":3604,"title":30190,"description":30191,"body":30192,"body_url":3604,"published":30193,"updated":30194,"approved":30193,"queued":3604,"status":29922,"requested_status":3604,"moderator_message":3604,"license":30195,"downloads":30198,"followers":30199,"categories":30200,"additional_categories":30201,"loaders":30202,"versions":30203,"icon_url":30360,"issues_url":30361,"source_url":30362,"wiki_url":30363,"discord_url":30364,"donation_urls":30365,"gallery":30366,"color":30367,"thread_id":30187,"monetization_status":29963},[1283,1184,859,853],"OrB5XFtI","custom-machinery","tR6kRFku","Custom Machinery","Make your dream machine come true","# Custom Machinery\n\n***make your dream machine come true***\n\n \n\nDid you ever been in the situation where, when creating your awesome modpack, you wanted to add a custom recipe but no available machine in your pack match what you want ?\n\nLike \"I want a machine that takes 3 items, 5 differents fluids and some energy to create another item\" but no machine can do that.\n\nOr the case when you found a mod that add a machine that can fit your needs but the mod also add tons of stuff that you don't want in your pack.\n\n \n\nWell this mod let you create your own machines using datapacks and add them in the game.\n\nYou can customise everything about your custom machine, from the appearance (model, textures, sounds, lightning, custom gui) to the functionality (how many inputs and outputs, their type and capacity) and of course you can add your own recipes that will be processed by the machine.\n\n \n\n## Currently a custom machine can :\n\n- Have the appearance you want (item, block, or even a custom model).\n- Have differents appearances based on it's status (idle/running/errored/paused).\n- Emit light based on if the machine is processing a recipe.\n- Play a sound when the machine is processing a recipe.\n- Contains FE (Forge Energy, compatible with RF)\n- Contains any fluid, you decide the number of internal fluid tanks, their capacity and max input and output.\n- Contains any item, you decide the number of internal item slots.\n- Have a custom GUI when you click on the machine, where you can see the contents of the machine and the progress of the recipe.\n- Pause based on a redstone signal (configurable in the machine json)\n- Emit a redstone signal based on it's status (also configurable in the machine json)\n- Receive custom defined upgrades that change the processing of recipes (inputs/outputs/speed)\n- Be configured to allow input or outputs of energy, items and fluid for each slot/tank/buffer for each side separately.\n \n\n## Currently a custom machine recipe can :\n\n- Consume or produce FE (Forge Energy, compatible with RF) on a per-tick basis or in one time.\n- Consume or produce any fluid on a per-tick basis or in one time, works with fluid tags.\n- Consume or produce any item, works with item tags. Support NBT and durability.\n- Process a recipe only at a certain time of the Minecraft world day.\n- Process a recipe only at a certain world position, biome or dimension.\n- Use a command when a recipe start, is processing or finish.\n- Require the usage of a fuel item to burn (like the furnace).\n- Consume or produce FE, fluids, items and use commands with a probablity (chance to be consumed/produced).\n- Give effects to nearby mobs.\n- Process a recipe only under a specific weather.\n- Process a recipe only when the machine receive a specific redstone signal.\n- Check for nearby entities, consume their health points or kill them.\n- Check for a specific sky/block light level.\n- Check/place/replace/break/destroy nearby blocks.\n- Require a complex structure to be formed around the machine.\n- Output items based on a loot table file.\n- Drop or consume items on ground.\n- Process Crafttweaker and KubeJS scripts.\n \n\nYou can find some examples of working custom machines [here](https://github.com/Frinn38/Custom-Machinery/tree/1.18.2/test_datapack/data/custommachinery/machines) or download the [Test Datapack](https://download-directory.github.io/?url=https%3A%2F%2Fgithub.com%2FFrinn38%2FCustom-Machinery%2Ftree%2F1.16.5%2Ftest_datapack).\n\n \n\nYou can download the [Test Resourcepack](https://download-directory.github.io/?url=https://github.com/Frinn38/Custom-Machinery/tree/1.16.5/test_resourcepack) to see how a custom json model can be applied to a machine (the \"stone generator\" in this example)\n\n \n\nAll of this can be made using a json file in a datapack, and all changes to this file can ba applied in-game with the /reload command, no reboot of the game are needed.\n\n \n\nThis mod comes with a full compatibility with JEI and The One Probe and the usage of these mods are heavily advised to use Custom Machinery in the best conditions.\n\n \nThis mod include complete Crafttweaker and KubeJS support for creating recipes and upgrades.\n\n**The Fabric version requires [Reborn Core](https://www.curseforge.com/minecraft/mc-mods/reborncore)**\n \n\n**Wiki** : All info you may need to make your custom machines can be found on the wiki : https://frinn.gitbook.io/custom-machinery-1.18/\n\n**Issues** : If you find any bugs or if you want to suggest a new feature or functionality : https://github.com/Frinn38/Custom-Machinery/issues\n\n**Discord** : For questions or support, join the Discord Server : https://discord.gg/dw9tjY4eKY\n\n**License** : This mod is licensed under the GNU LESSER GENERAL PUBLIC LICENSE you are free to use this mod in any modpack.","2022-07-09T13:28:06.464729Z","2026-06-17T13:38:44.999731Z",{"id":30196,"name":30197,"url":3604},"LGPL-3.0-only","GNU Lesser General Public License v3.0 only",93793,45,[288,303],[],[346,354,385],[30204,30205,30206,30207,30208,30209,30210,30211,30212,30213,30214,30215,30216,30217,30218,30219,30220,30221,30222,30223,30224,30225,30226,30227,30228,30229,30230,30231,30232,30233,30234,30235,30236,30237,30238,30239,30240,30241,30242,30243,30244,30245,30246,30247,30248,30249,30250,30251,30252,30253,30254,30255,30256,30257,30258,30259,30260,30261,30262,30263,30264,30265,30266,30267,30268,30269,30270,30271,30272,30273,30274,30275,30276,30277,30278,30279,30280,30281,30282,30283,30284,30285,30286,30287,30288,30289,30290,30291,30292,30293,30294,30295,30296,30297,30298,30299,30300,30301,30302,30303,30304,30305,30306,30307,30308,30309,30310,30311,30312,30313,30314,30315,30316,30317,30318,30319,30320,30321,30322,30323,30324,30325,30326,30327,30328,30329,30330,30331,30332,30333,30334,30335,30336,30