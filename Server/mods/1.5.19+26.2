2348,"featured":439,"title":32349,"description":3604,"created":32350,"ordering":29950},"https://cdn.modrinth.com/data/OsEtZi86/images/5fe468e3f93a44419cc0997469d114bb12c8711b_350.webp","https://cdn.modrinth.com/data/OsEtZi86/images/5fe468e3f93a44419cc0997469d114bb12c8711b.png","Without pack","2026-06-17T12:13:47.093302Z",{"url":32352,"raw_url":32353,"featured":861,"title":32354,"description":3604,"created":32355,"ordering":30063},"https://cdn.modrinth.com/data/OsEtZi86/images/dc7c262856df2c455c705644ec1741ce6632ae38_350.webp","https://cdn.modrinth.com/data/OsEtZi86/images/dc7c262856df2c455c705644ec1741ce6632ae38.png","With Pack","2026-06-17T12:14:04.529097Z",16188936,"JUPOCqVM",{"client_side":29935,"server_side":29934,"game_versions":32359,"id":32360,"slug":32361,"project_type":31,"team":32362,"organization":3604,"title":32363,"description":32364,"body":32365,"body_url":3604,"published":32366,"updated":32367,"approved":32368,"queued":32369,"status":29922,"requested_status":29922,"moderator_message":3604,"license":32370,"downloads":32371,"followers":32372,"categories":32373,"additional_categories":32374,"loaders":32375,"versions":32376,"icon_url":32389,"issues_url":3604,"source_url":3604,"wiki_url":3604,"discord_url":3604,"donation_urls":32390,"gallery":32393,"color":32394,"thread_id":32395,"monetization_status":29963},[571,517,511,499],"OsGMNhUr","buttonanimations","1CzPY2uL","Button Animations","Adds satisfying click and hover animations to buttons","# Button Animations\n\nButton Animations is a lightweight client-side mod that improves how Minecraft buttons feel.\n\nInstead of the default hover outline, buttons smoothly scale up when hovered and ease back down when clicked, creating a cleaner and more responsive UI. The result is subtle, satisfying feedback that makes menus feel more polished without changing their layout or functionality.\n\n## Features\n\n- Removes the default button hover outline\n- Adds a smooth hover grow animation\n- Adds a soft click press-and-bounce effect\n- Has a config screen\n- Works across Minecraft's standard button-based menus\n- Client-side only\n\n## Why use it?\n\nMinecraft's default buttons are functional, but a little stiff. Button Animations keeps the vanilla look while making interaction feel more modern and tactile. It is designed to be noticeable without being distracting.\n\n## Compatibility\n\n- Fabric\n- Client-side only\n- [Button Fix](https://modrinth.com/mod/buttonfix) recommended\n\nThis mod does not need to be installed on the server.\n\n## Notes\n\nButton Animations focuses only on button interaction and visual feedback. It does not add new menus, settings, or gameplay changes. The default keybind for the config is \"B\".\n","2026-03-31T15:01:26.319314Z","2026-05-06T17:24:37.739280Z","2026-04-12T21:48:10.420720Z","2026-04-01T13:09:57.907290Z",{"id":30061,"name":10,"url":3604},3568,24,[100,134,288],[],[346],[32377,32378,32379,32380,32381,32382,32383,32384,32385,32386,32387,32388],"x9W9wTL4","l8l7J4Kd","ZiRVU6wl","3zCRIrES","c42pavX6","YyoF7V8V","BmEO9w5S","cpXYRfxo","yhXlHgQp","Mu4ovqei","KhbHPvhg","QvpjzWhc","https://cdn.modrinth.com/data/OsGMNhUr/f7af2104978645b021b02aafb8681879424292d8.gif",[32391],{"id":3161,"platform":3162,"url":32392},"https://ko-fi.com/noslow",[],7434609,"iFtDuXKo",{"client_side":29935,"server_side":29935,"game_versions":32397,"id":32398,"slug":32399,"project_type":31,"team":32400,"organization":3604,"title":32401,"description":32402,"body":32403,"body_url":3604,"published":32404,"updated":32405,"approved":32406,"queued":32407,"status":29922,"requested_status":29922,"moderator_message":3604,"license":32408,"downloads":32409,"followers":29950,"categories":32410,"additional_categories":32411,"loaders":32412,"versions":32413,"icon_url":32420,"issues_url":32421,"source_url":32422,"wiki_url":32422,"discord_url":3604,"donation_urls":32423,"gallery":32424,"color":32425,"thread_id":32426,"monetization_status":29963},[1055,1022,980,974,896,853],"Oqaoi911","cheapslate_","vi6lGdlH","Cheapslate","Instant-mine deepslate with Efficiency 5, Haste 2, Netherite Pickaxe!","Cheapslate, as a reference to [Mumbo Jumbo's shop, Cheapslate](https://hermitcraft.fandom.com/wiki/Not-So-Cheapslate), is a simple mod to allow the instant-mining of deepslate, when using a Netherite Pickaxe with Efficiency 5 and Haste 2.\n\nSupported Versions (Neo/forge): [1.20.1, 1.20.2, 1.20.3, 1.20.4, 1.20.6, 1.21.1]\u003Cbr/>\nSupported Versions (Fabric): 1.21.x soon, 1.20.x if requested\n\nConfig values:\n- Efficiency_Level: the required level of efficiency (default 5, -1 to disable)\n- Haste_Level: the required level of haste (default 1, meaning level 2, -1 to disable)\n\nTags:\n- item tag: `#cheapslate:fast_pickaxes`, list of pickaxes that have additional instant-mine ablities, defaults to just `minecraft:netherite_pickaxe`.\n- block tag: `#cheapslate:fast_blocks`, list of blocks that can be instant-mined by select tools, with the above conditions, defaults to just `minecraft:deepslate`.","2025-09-24T07:05:46.975102Z","2025-09-25T00:11:06.061341Z","2025-09-25T03:36:00.321532Z","2025-09-24T07:25:01.245218Z",{"id":29947,"name":29948,"url":3604},130,[303],[105,134],[354,385],[32414,32415,32416,32417,32418,32419],"a2XdB0gw","bRT8DpjW","Ve5qiV48","yH9MGbYf","jo26bRt7","jX1Geq8d","https://cdn.modrinth.com/data/Oqaoi911/e5bd329e6bc5153c8d0b2b6ad3fbd4eb88771d50_96.webp","https://github.com/Tcat2000/Cheapslate/issues","https://github.com/Tcat2000/Cheapslate",[],[],4144445,"gBlFAfGe",{"client_side":29935,"server_side":29935,"game_versions":32428,"id":32429,"slug":32430,"project_type":34,"team":32431,"organization":3604,"title":32432,"description":32433,"body":32434,"body_url":3604,"published":32435,"updated":32436,"approved":32437,"queued":32438,"status":29922,"requested_status":29922,"moderator_message":3604,"license":32439,"downloads":32442,"followers":29950,"categories":32443,"additional_categories":32444,"loaders":32445,"versions":32446,"icon_url":32448,"issues